# The live apex host already redirects to www. These rules say the same thing
# in the repo. They are forced so a file at the same path cannot keep the
# request on the apex host.
https://weeklymealplan.space/*  https://www.weeklymealplan.space/:splat  301!
http://weeklymealplan.space/*  https://www.weeklymealplan.space/:splat  301!

# Prerendered public pages, assets, robots.txt, sitemap.xml, ads.txt, llms.txt,
# and the IndexNow key file are real files. These rules are not forced, so a
# later fallback cannot replace them.
/aa07e5ec709905f895fcccc55555a4c9.txt  /aa07e5ec709905f895fcccc55555a4c9.txt  200

# Real image and icon files. These rules are not forced and come before the
# unknown-path fallback, so it cannot replace them.
/og-image.png  /og-image.png  200
/favicon.ico   /favicon.ico   200
/vite.svg      /vite.svg      200

